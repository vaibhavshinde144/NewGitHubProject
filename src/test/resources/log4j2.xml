<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
 
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- Rolling File Appender (Creates a new log file when it reaches 10MB) -->
        <File name="FileLogger" fileName="logs/automation.log">
        <PatternLayout>
        <Pattern>"%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger - %msg%n"</Pattern>
            </PatternLayout>
                </File>
    </Appenders>

    <Loggers>
        <!-- Root Logger set to INFO level -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Root>
    </Loggers>
</Configuration>
